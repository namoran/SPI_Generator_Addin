<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>A8A75FC5-8D9C-449C-860C-A6B9E6F1F778</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Moran Rocks LLC</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="SPI Generator" />
  <Description DefaultValue="Transfers pay item quantities from an FDEP Request for Change (RFC) workbook into the Schedule of Payment Items (SPI) workbook open in Excel. Only task quantity cells are changed. Excel recalculates all totals." />
  <IconUrl DefaultValue="https://namoran.github.io/SPI_Generator_Addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://namoran.github.io/SPI_Generator_Addin/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://moran.rocks" />
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://namoran.github.io/SPI_Generator_Addin/src/taskpane/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="MoranRocks.SpiGenerator.Group1">
                <Label resid="Group1Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="MoranRocks.SpiGenerator.TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://namoran.github.io/SPI_Generator_Addin/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://namoran.github.io/SPI_Generator_Addin/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://namoran.github.io/SPI_Generator_Addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://namoran.github.io/SPI_Generator_Addin/src/commands/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://namoran.github.io/SPI_Generator_Addin/src/taskpane/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://namoran.github.io/SPI_Generator_Addin/" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="SPI Generator" />
        <bt:String id="Group1Label" DefaultValue="SPI Generator" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="SPI Generator" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open your SPI workbook, select the RFC workbook in the pane, and select Generate. The RFC quantities are added into the open workbook." />
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Transfer RFC pay item quantities into this SPI workbook" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
